10:["$","div",null,{"className":"fractals-explorer-intro","children":[["$","p",null,{"className":"eyebrow","children":"An example of a self-similar fractal"}],["$","h2",null,{"children":"The Sierpiński gasket"}],["$","p",null,{"children":"Start with an equilateral triangle, join the midpoints of its sides to form four smaller congruent triangles, remove the central triangle, and repeat the process on each of the three remaining triangles. Use the controls below to watch the pattern emerge, one construction level at a time."}]]}]
