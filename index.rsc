f:["$","section",null,{"className":"teaching section shell","id":"teaching","aria-label":"Teaching","children":[["$","div",null,{"className":"teaching-intro","children":["$","div",null,{"className":"teaching-copy","children":[["$","p",null,{"className":"teaching-statement","children":"Teaching is my life's passion."}],["$","div",null,{"className":"teaching-detail","children":[["$","p",null,{"children":"As an undergraduate, I worked part-time as a private tutor. At university level, I have experience teaching single- and multivariable calculus, linear algebra, transform methods, discrete mathematics, and mathematics for engineers. I also have experience teaching a range of middle- and high-school courses in the Swedish and Greek curricula. Beyond mathematics, I have taught Bachata, a very popular type of Latin dance."}],["$","p",null,{"children":["I have also given popular-science talks at high schools on fractals, infinity, and other cool mathematical topics, aiming to inspire students and spark an interest in science. I am always happy to promote mathematics through outreach. If you would like me to speak at your school, university, or event about fractals or another engaging mathematical topic, "," ",["$","a",null,{"href":"#contact","children":"please get in touch"}],"."]}]]}]]}]}],["$","div",null,{"className":"teaching-photos","children":[["$","figure",null,{"className":"teaching-photo","children":[["$","div",null,{"className":"teaching-photo-frame","children":["$","img",null,{"src":"/photos/teaching-uppsala-university.jpg","alt":"","width":"2000","height":"1380","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Photographed at Uppsala University by professional photographer Mikael Wallerstedt and used in the university's advertising."}]]}],["$","figure",null,{"className":"teaching-photo","children":[["$","div",null,{"className":"teaching-photo-frame","children":["$","img",null,{"src":"/photos/bachata-instruction.jpg","alt":"","width":"1